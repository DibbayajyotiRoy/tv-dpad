{
  "name": "tv-dpad",
  "version": "0.1.0",
  "description": "Tiny, dependency-free spatial D-pad navigation for TV web apps (Fire TV, Android TV, smart TVs).",
  "keywords": ["tv", "dpad", "spatial-navigation", "focus", "fire-tv", "android-tv", "remote"],
  "license": "MIT",
  "author": "Dibbayajyoti Roy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && sed 's/^export //' dist/index.js > dist/index.global.js",
    "test": "npm run build && node --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": { "react": ">=17" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "@types/react": "^19.0.0", "typescript": "^5.6.0" }
}
